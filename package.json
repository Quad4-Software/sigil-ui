{
  "name": "sigil-ui",
  "version": "0.10.0",
  "description": "Svelte 5 runes component library. CSS framework agnostic, themed through CSS variables.",
  "license": "0BSD",
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Quad4-Software/sigil-ui.git"
  },
  "homepage": "https://quad4-software.github.io/sigil-ui/",
  "keywords": [
    "svelte",
    "svelte5",
    "runes",
    "component-library",
    "ui",
    "css-agnostic"
  ],
  "engines": {
    "node": ">=22"
  },
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./uno": {
      "types": "./dist/uno.d.ts",
      "default": "./dist/uno.js"
    },
    "./panda": {
      "types": "./dist/panda.d.ts",
      "default": "./dist/panda.js"
    },
    "./css": {
      "types": "./css/index.d.ts",
      "default": "./css/index.mjs"
    },
    "./theme.css": "./dist/theme/sigil.css",
    "./components.css": "./dist/components.css",
    "./components.min.css": "./dist/components.min.css",
    "./css-parts.json": "./dist/css-parts.json",
    "./headless": {
      "types": "./dist/headless/index.d.ts",
      "default": "./dist/headless/index.js"
    },
    "./tailwind.css": "./dist/theme/tailwind.css",
    "./manifest.json": "./dist/manifest.json",
    "./package.json": "./package.json",
    "./themes/*": "./dist/theme/themes/*",
    "./base.css": "./dist/theme/base.css"
  },
  "bin": {
    "sigil-ui": "./bin/sigil.mjs"
  },
  "files": [
    "dist",
    "bin",
    "css"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "svelte-package && node scripts/gen-manifest.mjs && node scripts/gen-css.mjs",
    "build:demo": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "check:tsgo": "svelte-check --tsgo --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "llms": "node scripts/gen-llms.mjs",
    "pack:check": "publint",
    "prepublishOnly": "pnpm build && publint"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@sveltejs/package": "2.5.8",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/svelte": "5.4.2",
    "@types/node": "22.20.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "5.0.0",
    "axe-core": "4.13.0",
    "eslint": "10.10.0",
    "eslint-plugin-svelte": "3.23.0",
    "globals": "17.12.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "prettier-plugin-svelte": "4.1.1",
    "publint": "0.3.24",
    "svelte": "5.57.0",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
